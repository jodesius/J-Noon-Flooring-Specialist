# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Django ---
# Generate one with:
#   python -c "import secrets; print('django-insecure-' + secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# --- Database ---
# Leave blank to use a local SQLite file.
# For Neon, paste the pooled connection string from the Neon dashboard,
# e.g. postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Email (Gmail SMTP) ---
# Leave both blank to print emails to the runserver console instead of sending.
# EMAIL_HOST_PASSWORD must be a Google "App Password" (16 chars, no spaces),
# created at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=J-Noon Flooring Specialist <your-address@gmail.com>
