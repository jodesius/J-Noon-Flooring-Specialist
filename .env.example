# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Django ---
# Generate one with:
#   python -c "import secrets; print('django-insecure-' + secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# --- Database ---
# Leave blank to use a local SQLite file.
# For Neon, paste the pooled connection string from the Neon dashboard,
# e.g. postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Email (SMTP, any provider) ---
# Leave USER and PASSWORD blank to print emails to the runserver console
# instead of sending them.
#
# Host/port default to Gmail. Override for another provider, e.g. Brevo:
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
# Set EMAIL_USE_SSL=1 only if the provider needs implicit SSL (port 465);
# otherwise STARTTLS is used.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=J-Noon Flooring Specialist <your-sending-address>

# --- AI quoting (bookings) ---
# From https://console.anthropic.com/ -> API keys (pay-as-you-go, ~1-3p per quote).
# Leave blank and the quote page asks the customer to book a call instead.
ANTHROPIC_API_KEY=
# Optional overrides:
# ANTHROPIC_QUOTE_MODEL=claude-sonnet-5
# QUOTE_DAILY_LIMIT=5
# QUOTING_PREVIEW=1   # DEBUG only - preview the quote flow with a canned estimate

# --- Google Calendar (bookings "book a call") ---
# Create a service account in Google Cloud, enable the Calendar API, then
# share your calendar with the service-account email ("Make changes to events").
# Leave blank and call requests are just saved + emailed (no calendar event).
GOOGLE_CALENDAR_ID=
# The whole service-account JSON key, on one line, OR a path to the .json file:
GOOGLE_SERVICE_ACCOUNT_JSON=
# BOOKINGS_TIMEZONE=Europe/London
# CALL_DAILY_LIMIT=3

# --- Media storage (Cloudinary) ---
# Leave CLOUDINARY_URL blank to store uploads in the local media/ folder.
# Copy the FULL "API environment variable" from the Cloudinary dashboard -
# it must end with @<cloud_name>:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder inside your Cloudinary account that all uploads go into.
CLOUDINARY_FOLDER=media
